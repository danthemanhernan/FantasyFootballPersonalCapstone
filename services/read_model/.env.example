# Copy this file to .env for local container-backed development.
READ_MODEL_BACKEND=postgres-redis
POSTGRES_DSN=postgresql://fantasy_hud:fantasy_hud_dev@localhost:55432/fantasy_hud
REDIS_URL=redis://localhost:56379
AUTH_SECRET=replace-with-at-least-32-random-characters
PROVIDER_ENCRYPTION_KEY=replace-with-an-independent-random-secret
INGEST_API_KEY=replace-with-an-ingestion-service-key
OTEL_EXPORTER_OTLP_ENDPOINT=
