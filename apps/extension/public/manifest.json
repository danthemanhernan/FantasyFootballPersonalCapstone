{
  "manifest_version": 3,
  "name": "Fantasy Football HUD",
  "version": "0.1.0",
  "description": "A live fantasy football scoreboard for your browser.",
  "action": {
    "default_title": "Fantasy Football HUD",
    "default_popup": "index.html"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://lm-api-reads.fantasy.espn.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://tv.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
